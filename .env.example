# Conservar la clave real solo en .env o en el gestor de secretos.
API_KEY_GEMINI=

# URI PostgreSQL de Supabase: Connect > Direct connection o Session pooler.
# Sustituir la contraseña y codificar los caracteres reservados de la URI.
SUPABASE_DB_URL=
SUPABASE_DB_SCHEMA=crm
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_CONNECT_TIMEOUT=15
SUPABASE_DB_STATEMENT_TIMEOUT_MS=120000

# Django: generar una clave privada; True solo durante desarrollo local.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# La web usa una credencial PostgreSQL diferente de SUPABASE_DB_URL y sin
# privilegios de carga o migración. Si falta, Django usa SQLite solo en desarrollo.
DJANGO_DATABASE_URL=
DJANGO_DB_SCHEMA=crm
DJANGO_DB_CONNECT_TIMEOUT=15
DJANGO_DB_STATEMENT_TIMEOUT_MS=120000

# Producción: HTTPS y cookies seguras; activar solo detrás de proxy HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_ENV=development
